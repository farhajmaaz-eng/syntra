# Where SQLite, checkpoints, Codex auth and local assets live.
SYNTRA_DATA_DIR=

# Next starts an embedded worker by default. Set to 1 when running
# `npm run worker` separately (as `npm run local` does).
WORKER_EXTERNAL=
WORKER_PORT=4318

# Roblox Studio official MCP server command/arguments.
ROBLOX_MCP_COMMAND=
ROBLOX_MCP_ARGS=

# OpenAI Codex. Sign-in normally happens on the Codex page and is stored by the
# official app-server under $SYNTRA_DATA_DIR/codex-home.
CODEX_PROJECT_ROOT=
CODEX_MODEL=
# CODEX_API_KEY=
# CODEX_COMMAND=
# CODEX_APP_SERVER_COMMAND=
# CODEX_APP_SERVER_ARGS=

# Optional bearer token for external clients of the local Illustrate MCP endpoint.
SYNTRA_ILLUSTRATE_MCP_KEY=

# Syntra Graphics connects to a pinned Penpot editor file and page via Penpot MCP.
# SYNTRA_PENPOT_FILE_URL="https://design.penpot.app/#/workspace?file-id=...&page-id=..."
# SYNTRA_PENPOT_MCP_URL=http://127.0.0.1:4401/mcp
# SYNTRA_PENPOT_SESSION_ID=
